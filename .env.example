# ===========================================
# Leads Scraper - Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# Command: cp .env.example .env.local (macOS/Linux)
# Command: copy .env.example .env.local (Windows)
# ===========================================

# ===========================================
# REQUIRED: Backend API Configuration
# ===========================================
# URL where your backend server is running
# For local development: http://localhost:3001
# For production (Render): https://your-app-name.onrender.com
NEXT_PUBLIC_SCRAPER_API_URL=http://localhost:3001

# ===========================================
# REQUIRED: Database (Neon Postgres)
# ===========================================
# Use the POOLED connection string (hostname contains "-pooler")
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require

# ===========================================
# REQUIRED: Authentication (Auth.js + Google OAuth)
# ===========================================
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console -> Credentials -> OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===========================================
# OPTIONAL: Google Sheets Integration
# ===========================================
# Follow GOOGLE_SHEETS_SETUP.md for detailed instructions

# Sheet tab name (defaults to "Leads" if not specified)
# GOOGLE_SHEETS_SHEET_NAME=Leads

# Google Service Account Credentials (JSON format, single line)
# Download this from Google Cloud Console → Service Accounts → Keys
# IMPORTANT: The entire JSON must be on ONE line, wrapped in single quotes
# GOOGLE_SHEETS_CREDENTIALS='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'