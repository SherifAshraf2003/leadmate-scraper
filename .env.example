# ===========================================
# Leads Scraper - Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# Command: cp .env.example .env.local (macOS/Linux)
# Command: copy .env.example .env.local (Windows)
# ===========================================

# ===========================================
# REQUIRED: Backend API Configuration
# ===========================================
# URL where your backend server is running
# For local development: http://localhost:3001
# For production (Render): https://your-app-name.onrender.com
NEXT_PUBLIC_SCRAPER_API_URL=http://localhost:3001

# ===========================================
# REQUIRED: Database (Neon Postgres)
# ===========================================
# Use the POOLED connection string (hostname contains "-pooler") — the app's
# runtime queries go through this one.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require

# Use the UNPOOLED connection string (no "-pooler" in the hostname). Prisma
# Migrate needs a session-level connection to take its advisory lock; Neon's
# pooled endpoint is transaction-mode PgBouncer and cannot provide that, so
# `prisma migrate deploy` (which runs on every build — see package.json)
# requires this separate variable even though it points at the same database.
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require

# ===========================================
# REQUIRED: Authentication (Auth.js + Google OAuth)
# ===========================================
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console -> Credentials -> OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===========================================
# REQUIRED: Scrape token (shared with the backend)
# ===========================================
# openssl rand -base64 32
# The backend must have this EXACT same value. Never prefix with NEXT_PUBLIC_.
SCRAPE_TOKEN_SECRET=
